#!/bin/bash
# -*- sh -*-

function usage () {
   echo "Usage: make_pull [ -c configuration ] [ -v version (default: git) ] package"
}

if [ $# -eq 0 -o "$1" = "-h" ] ; then
    usage && exit 0
fi

rpmsystem=$(hostname)
rpmsystem=${rpmsystem#*.} # remove build or staff
rpmsystem=${rpmsystem%%.*} # remove tacc.utexas.edu

version=git
configuration=
zip=0
while [ $# -gt 1 ] ; do
    if [ "$1" = "-h" ] ; then
        usage && exit 0
    elif [ "$1" = "-c" ] ; then
        shift && configuration=$1 && shift
    elif [ "$1" = "-v" ] ; then
        shift && version=$1 && shift
    fi
done

## set -x
package=$1
rpms=/admin/build/admin/rpms/${rpmsystem}
scripts=${rpms}/SPECS/RPMtheNextGeneration
sources=${rpms}/SOURCES

if [ ! -d ${scripts}/makefiles/$package ] ; then
    echo "Could not find directory: $package"
    exit 1
fi

#
# Find MrPackMod
#
export PATH=$(pwd)/MrPackMod:${PATH}
export PYTHONPATH=$(pwd):${PYTHONPATH}

cd ${scripts}/makefiles/$package
DOWNLOADPATH=${rpms}/SOURCES \
    TACC_FAMILY_COMPILER=intel \
    PACKAGEROOT=${rpms} PACKAGE=${package} \
    PACKAGEVERSION=${version} \
    mpm.py -t \
        $( if [ ! -z "${configuration}" ] ; then echo "-c ${configuration}" ; fi ) \
        newclone betar

